<view class="edit-page page-container">
  <!-- Avatar -->
  <view class="form-section card">
    <view class="form-item avatar-item" bindtap="onChooseAvatar">
      <text class="form-label">头像</text>
      <view class="avatar-right">
        <image
          class="edit-avatar"
          src="{{avatarUrl || '/common/images/default-avatar.png'}}"
          mode="aspectFill"
        />
        <text class="form-arrow">></text>
      </view>
    </view>
  </view>

  <!-- Basic Info -->
  <view class="form-section card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        value="{{form.nickname}}"
        placeholder="请输入昵称"
        placeholder-class="form-placeholder"
        bindinput="onInputNickname"
      />
    </view>

    <view class="form-item">
      <text class="form-label">性别</text>
      <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="picker-value">{{genderOptions[genderIndex].label}} ></view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        value="{{form.phone}}"
        placeholder="请输入手机号"
        placeholder-class="form-placeholder"
        maxlength="11"
        bindinput="onInputPhone"
      />
    </view>

    <view class="form-item">
      <text class="form-label">网球水平</text>
      <picker mode="selector" range="{{tennisLevels}}" range-key="label" value="{{levelIndex}}" bindchange="onLevelChange">
        <view class="picker-value">
          {{levelIndex >= 0 ? tennisLevels[levelIndex].label : '请选择'}} >
        </view>
      </picker>
    </view>
  </view>

  <!-- Bio -->
  <view class="form-section card">
    <view class="form-item bio-item">
      <text class="form-label">个人简介</text>
      <textarea
        class="form-textarea"
        value="{{form.bio}}"
        placeholder="介绍一下自己..."
        placeholder-class="form-placeholder"
        maxlength="200"
        bindinput="onInputBio"
      />
      <text class="char-count">{{form.bio.length || 0}}/200</text>
    </view>
  </view>

  <!-- Submit -->
  <view class="submit-wrap safe-area-bottom">
    <button
      class="btn btn-primary btn-block"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      保存
    </button>
  </view>
</view>

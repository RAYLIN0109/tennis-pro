/* === Role Selection Page === */
.role-page {
  min-height: 100vh;
  background-color: var(--bg-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-6);
  padding-top: 160rpx;
}

/* === Hero === */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.hero-emoji {
  font-size: 80rpx;
  margin-bottom: var(--space-5);
}

.hero-title {
  font-size: 40rpx;
  font-weight: var(--font-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-3);
}

.hero-subtitle {
  font-size: var(--text-base);
  color: var(--text-secondary);
}

/* === Role Cards === */
.role-cards {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.role-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx var(--space-6);
  background-color: var(--bg-primary);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid var(--border-light);
}

.role-card:active {
  border-color: var(--accent);
  transform: scale(0.98);
}

.role-card-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-5);
}

.role-card-icon-student {
  background: linear-gradient(135deg, #EBF5FF, #DBEAFE);
}

.role-card-icon-coach {
  background: linear-gradient(135deg, var(--accent-light), var(--accent));
}

.role-card-emoji {
  font-size: 52rpx;
}

.role-card-title {
  font-size: var(--text-lg);
  font-weight: var(--font-bold);
  color: var(--text-primary);
  margin-bottom: var(--space-2);
}

.role-card-desc {
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

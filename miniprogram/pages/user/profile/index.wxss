.profile-page {
  padding: var(--space-4);
  padding-bottom: 32rpx;
}

.profile-header {
  margin-bottom: var(--space-4);
}

.profile-avatar-row {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.profile-name-area {
  flex: 1;
  margin-left: var(--space-5);
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: var(--text-xl);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.profile-edit-link {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.profile-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: var(--space-4);
  padding: var(--space-6) var(--space-4);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: var(--text-2xl);
  font-weight: var(--font-bold);
  color: var(--text-primary);
  line-height: 1.2;
}

.stat-label {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.profile-menu {
  padding: 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5) var(--space-5);
  border-bottom: 1rpx solid var(--border-light);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: var(--text-base);
  color: var(--text-primary);
}

.menu-arrow {
  font-size: var(--text-sm);
  color: var(--text-tertiary);
}

/* === Become Coach CTA === */
.menu-item-apply {
  background-color: #FAFFF0;
  border-bottom: 2rpx solid var(--accent-light, #E8F5E9);
}
.menu-item-apply .menu-label {
  color: var(--accent-dark, #33691E);
  font-weight: var(--font-semibold);
}
.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.menu-sub {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}

/* === Coach Certification === */
.coach-cert-section {
  margin-bottom: var(--space-4);
}

.coach-cert-card {
  padding: var(--space-5);
  background-color: var(--bg-primary);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.cert-title {
  display: block;
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-4);
}

.cert-status {
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
}

.cert-pending {
  background-color: #F5F5F5;
  color: #999999;
}

.cert-active {
  background-color: var(--accent-light);
  color: var(--accent-dark);
}

.cert-suspended {
  background-color: #FFF3E0;
  color: #FF9500;
}

.cert-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--space-3);
}

.btn-reapply {
  padding: 12rpx 32rpx;
  font-size: var(--text-sm);
  border-radius: var(--radius-full);
  background-color: var(--accent);
  color: var(--accent-contrast);
  border: none;
  line-height: 1;
}

.btn-reapply::after {
  border: none;
}

/* === Notification Badge === */
.profile-notify {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-5);
  margin-bottom: var(--space-4);
}

.notify-right {
  display: flex;
  align-items: center;
}

.badge-unread {
  background-color: #EF4444;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

/* === Empty State Wrapper（防止坍缩） === */
.profile-empty-wrap {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* === Skeleton Loader === */
.profile-skeleton {
  padding: 0;
}
.skel-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-4);
}
.skel-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.skel-lines {
  flex: 1;
  margin-left: var(--space-5);
  display: flex;
  flex-direction: column;
}
.skel-line {
  height: 24rpx;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
}
.skel-line-lg { width: 60%; height: 32rpx; }
.skel-line-sm { width: 30%; height: 20rpx; margin-bottom: 0; }
.skel-card {
  height: 160rpx;
  border-radius: 16rpx;
  margin-bottom: var(--space-4);
}
.skel-stats { height: 140rpx; }
.skel-menu-1, .skel-menu-2 { height: 100rpx; }
.skel-shimmer {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}
@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.post-detail {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.scroll-content {
  flex: 1;
  height: calc(100vh - 120rpx);
}

/* Loading */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #B8E600;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* Author Header */
.author-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.author-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.back-arrow {
  font-size: 36rpx;
  color: #333;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  object-fit: cover;
  margin-right: 16rpx;
}

.author-avatar-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #B8E600, #9ACD32);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.author-avatar-placeholder text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.author-detail {
  flex: 1;
}

.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.post-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.delete-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn text {
  font-size: 40rpx;
  color: #999;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* Topic Row */
.topic-row {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  gap: 16rpx;
}

.topic-badge {
  padding: 6rpx 20rpx;
  background: #F0FFB8;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #5B8C00;
  font-weight: 500;
}

.location-text {
  font-size: 24rpx;
  color: #999;
}

/* Post Content */
.post-content {
  padding: 0 32rpx 24rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* Images */
.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 0 32rpx 24rpx;
}

.grid-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.grid-image.single {
  width: 500rpx;
  height: 350rpx;
}

.grid-image.four {
  width: calc(50% - 4rpx);
  height: 300rpx;
}

/* Tags */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 32rpx 24rpx;
}

.tag {
  font-size: 26rpx;
  color: #B8E600;
}

/* Stats */
.stats-row {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx 20rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #999;
}

/* Actions */
.actions-row {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
}

.action-btn.liked {
  background: #FCE4EC;
}

.action-icon {
  font-size: 28rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

.action-btn.liked .action-text {
  color: #E53935;
}

/* Divider */
.divider-section {
  display: flex;
  align-items: center;
  padding: 0 32rpx 20rpx;
  gap: 16rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #f0f0f0;
}

.divider-text {
  font-size: 26rpx;
  color: #999;
  white-space: nowrap;
}

/* No Comments */
.no-comments {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}

/* Comment Item */
.comment-item {
  display: flex;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  object-fit: cover;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-avatar-placeholder {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #B8E600, #9ACD32);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-avatar-placeholder text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.comment-author {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}

.reply-tag {
  color: #999;
  font-size: 24rpx;
}

.reply-to-name {
  color: #B8E600;
  font-size: 26rpx;
}

.comment-actions {
  margin-top: 8rpx;
}

.comment-reply-btn {
  font-size: 24rpx;
  color: #B8E600;
}

/* Load More */
.load-more-comments {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #999;
}

/* Comment Input Bar */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.reply-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  margin-bottom: 8rpx;
}

.reply-hint text {
  font-size: 24rpx;
  color: #999;
}

.cancel-reply {
  color: #B8E600;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 100rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0e0e0;
}

.send-btn.active {
  background: #B8E600;
}

.send-btn text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}
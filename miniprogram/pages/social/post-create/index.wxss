.post-create {
  min-height: 100vh;
  background: #fff;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 10;
}

.header-left {
  width: 120rpx;
}

.cancel-text {
  font-size: 28rpx;
  color: #999;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.header-right {
  width: 120rpx;
  display: flex;
  justify-content: flex-end;
}

.submit-btn {
  padding: 12rpx 32rpx;
  border-radius: 36rpx;
  background: #e0e0e0;
}

.submit-btn.active {
  background: #B8E600;
}

.submit-btn text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* Scroll Content */
.scroll-content {
  height: calc(100vh - 120rpx);
}

/* Content Section */
.content-section {
  padding: 32rpx;
  position: relative;
}

.content-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

.chars-counter {
  position: absolute;
  bottom: 16rpx;
  right: 32rpx;
  font-size: 24rpx;
  color: #999;
}

/* Image Section */
.image-section {
  padding: 0 32rpx 24rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.remove-image {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-image text {
  font-size: 28rpx;
  color: #fff;
}

.image-picker {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.picker-icon {
  font-size: 48rpx;
  color: #ccc;
}

.picker-text {
  font-size: 22rpx;
  color: #ccc;
}

/* Form Sections */
.form-section {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
}

.form-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value text {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.form-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-text {
  font-size: 28rpx;
  color: #999;
}

.location-name {
  color: #333;
}

.action-icon {
  font-size: 32rpx;
}

/* Tags */
.tag-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.tag-input {
  flex: 1;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.tag-add-btn {
  padding: 12rpx 24rpx;
  background: #B8E600;
  border-radius: 32rpx;
}

.tag-add-btn text {
  font-size: 24rpx;
  color: #fff;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
  flex: 1;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: #F0FFB8;
  border-radius: 28rpx;
}

.tag-item text {
  font-size: 24rpx;
  color: #5B8C00;
}

.tag-remove {
  font-weight: 700;
  font-size: 28rpx;
}

/* Loading Overlay */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #B8E600;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666;
}
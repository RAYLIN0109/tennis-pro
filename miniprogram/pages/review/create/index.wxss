.review-page { padding: var(--space-4); }
.review-card { margin-bottom: var(--space-4); }
.card-title { font-size: var(--text-md); font-weight: var(--font-semibold); color: var(--text-primary); display: block; margin-bottom: var(--space-4); }
.rating-wrap { display: flex; justify-content: center; padding: var(--space-4) 0; }

.content-textarea { width: 100%; min-height: 200rpx; font-size: var(--text-base); color: var(--text-primary); line-height: var(--leading-relaxed); background: var(--bg-secondary); border-radius: var(--radius-md); padding: var(--space-4); }
.char-count { display: block; text-align: right; font-size: var(--text-xs); color: var(--text-tertiary); margin-top: 8rpx; }

.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item { position: relative; width: 180rpx; height: 180rpx; }
.preview-img { width: 100%; height: 100%; border-radius: var(--radius-md); }
.remove-btn { position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; background: var(--danger); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22rpx; }

.add-image { width: 180rpx; height: 180rpx; background: var(--bg-secondary); border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed var(--border); }
.add-icon { font-size: 48rpx; color: var(--text-tertiary); }
.add-text { font-size: var(--text-xs); color: var(--text-tertiary); margin-top: 4rpx; }

.submit-wrap { position: fixed; bottom: 0; left: 0; right: 0; padding: var(--space-4) var(--space-6); background: var(--bg-primary); box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06); }

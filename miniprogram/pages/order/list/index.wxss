.order-list-page { padding-bottom: 32rpx; }

.tab-bar {
  display: flex;
  background-color: var(--bg-primary);
  padding: 0 var(--space-4);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--space-4) 0;
  font-size: var(--text-base);
  color: var(--text-secondary);
  position: relative;
}

.tab-active {
  color: var(--accent);
  font-weight: var(--font-semibold);
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--accent);
  border-radius: 2rpx;
}

.order-list { padding: var(--space-3) var(--space-4); }

.order-card { margin-bottom: var(--space-4); padding: var(--space-5); }

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-3);
}

.order-no { font-size: var(--text-xs); color: var(--text-tertiary); }

.order-mid { margin-bottom: var(--space-3); }

.order-resource { display: flex; align-items: center; margin-bottom: var(--space-2); }

.order-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.order-resource-info { margin-left: var(--space-3); flex: 1; }

.order-resource-name {
  font-size: var(--text-md);
  font-weight: var(--font-medium);
  color: var(--text-primary);
  display: block;
}

.order-type { font-size: var(--text-xs); color: var(--text-secondary); }

.order-date { font-size: var(--text-sm); color: var(--text-secondary); }

.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--space-3);
  border-top: 1rpx solid var(--border-light);
}

.order-price { font-size: var(--text-lg); font-weight: var(--font-bold); color: var(--accent); }

.order-actions { display: flex; gap: 16rpx; }

.load-more { padding: var(--space-5) 0; }
.load-more-text { display: block; text-align: center; font-size: var(--text-sm); color: var(--text-tertiary); }

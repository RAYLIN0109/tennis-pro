.activity-create-page {
  min-height: 100vh;
  background: #f5f6f8;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  height: 100vh;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

.header-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.header-right {
  min-width: 80rpx;
}

.form-container {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.section-required {
  color: #ff4d4f;
  font-size: 28rpx;
  margin-left: 8rpx;
}

/* Activity Type Grid */
.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.type-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s ease;
}

.type-card.active {
  background: #E8F5C8;
  border-color: #B8E600;
}

.type-emoji {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-label {
  font-size: 24rpx;
  color: #333;
}

.type-card.active .type-label {
  color: #5B8C00;
  font-weight: 600;
}

/* Input */
.input-wrapper {
  position: relative;
}

.form-input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.input-length {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 24rpx;
  color: #999;
}

/* Textarea */
.textarea-wrapper {
  position: relative;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  font-size: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.textarea-length {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 24rpx;
  color: #999;
}

/* ===== Time Section ===== */
.time-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.time-block {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.time-block-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.time-pickers {
  display: flex;
  gap: 16rpx;
}

.time-pickers picker {
  flex: 1;
}

.time-picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8e8;
}

.time-picker-text {
  font-size: 28rpx;
  color: #333;
}

.time-picker-arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

.time-result {
  padding: 16rpx 20rpx;
  background: #E8F5C8;
  border-radius: 12rpx;
}

.time-result-text {
  font-size: 26rpx;
  color: #5B8C00;
}

/* Location */
.location-wrapper {
  position: relative;
}

.location-input {
  padding-right: 100rpx;
}

.location-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #B8E600;
  border-radius: 50%;
}

.location-btn-icon {
  font-size: 36rpx;
}

.location-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* People Section */
.people-section {
  display: flex;
  gap: 24rpx;
}

.people-card {
  flex: 1;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.people-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.people-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.control-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.control-btn text {
  font-size: 36rpx;
  color: #333;
}

.control-btn.disabled {
  opacity: 0.4;
}

.control-display {
  display: flex;
  align-items: baseline;
}

.control-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.control-unit {
  font-size: 24rpx;
  color: #666;
  margin-left: 8rpx;
}

/* Fee */
.fee-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fee-symbol {
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: 700;
}

.fee-input {
  width: 200rpx;
  height: 88rpx;
  font-size: 40rpx;
  font-weight: 600;
  background: #f8f9fa;
  border-radius: 12rpx;
  text-align: center;
}

.fee-unit {
  font-size: 28rpx;
  color: #666;
}

.fee-switch {
  margin-left: auto;
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  border-radius: 32rpx;
}

.fee-switch-text {
  font-size: 26rpx;
  color: #666;
}

/* Tags */
.tags-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  padding: 16rpx 32rpx;
  background: #f8f9fa;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid #e8e8e8;
}

.tag-chip.active {
  background: #E8F5C8;
  border-color: #B8E600;
  color: #5B8C00;
}

/* Safe Bottom */
.safe-bottom-floating {
  height: 160rpx;
}

/* ===== Floating Submit Button ===== */
.fab-submit {
  position: fixed;
  bottom: 64rpx;
  right: 32rpx;
  min-width: 180rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  background: linear-gradient(135deg, #B8E600 0%, #9ACD00 100%);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 30rpx rgba(184, 230, 0, 0.4);
  z-index: 100;
}

.fab-submit.disabled {
  background: #bbb;
  box-shadow: none;
}

.fab-submit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}
.vdetail-page { padding-bottom: 32rpx; }

.venue-swiper { width: 100%; height: 400rpx; }
.swiper-img { width: 100%; height: 100%; }

.info-card, .address-card, .court-section, .schedule-section, .amenities-section, .reviews-section {
  margin: var(--space-4);
}

.info-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); }
.venue-name { font-size: var(--text-xl); font-weight: var(--font-bold); color: var(--text-primary); }

.quick-info { display: flex; align-items: center; gap: 8rpx; }
.quick-item { font-size: var(--text-sm); color: var(--text-secondary); }
.quick-dot { font-size: var(--text-sm); color: var(--text-tertiary); }
.accent-text { color: var(--accent); font-weight: var(--font-medium); }

.address-row { display: flex; align-items: center; justify-content: space-between; }
.address-info { flex: 1; }
.address-text { font-size: var(--text-base); color: var(--text-primary); display: block; margin-bottom: 4rpx; }
.district-text { font-size: var(--text-sm); color: var(--text-secondary); }
.navigate-btn { flex-shrink: 0; padding: 0 24rpx; height: 56rpx; }

.court-scroll { white-space: nowrap; margin-top: var(--space-3); }
.court-tab {
  display: inline-flex; flex-direction: column; align-items: center;
  padding: var(--space-3) var(--space-5); border-radius: var(--radius-md);
  margin-right: 16rpx; background-color: var(--bg-secondary); min-width: 160rpx;
}
.court-tab-active { background-color: var(--accent-light); border: 2rpx solid var(--accent); }
.court-name { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--text-primary); }
.court-type { font-size: var(--text-xs); color: var(--text-secondary); margin-top: 4rpx; }

.date-scroll { white-space: nowrap; margin-bottom: var(--space-4); }
.date-tab {
  display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
  width: 120rpx; height: 100rpx; border-radius: var(--radius-md); margin-right: 16rpx;
  background-color: var(--bg-secondary); white-space: pre-line; text-align: center;
}
.date-tab-active { background-color: var(--accent); }
.date-tab-active .date-label { color: var(--accent-contrast); }
.date-label { font-size: var(--text-sm); color: var(--text-primary); line-height: 1.4; }

.section-header { display: flex; justify-content: space-between; align-items: center; }
.section-more { font-size: var(--text-sm); color: var(--accent); }

.amenities-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: var(--space-3); }
.amenity-item {
  font-size: var(--text-sm); color: var(--text-secondary);
  background-color: var(--bg-secondary); padding: 8rpx 24rpx; border-radius: var(--radius-full);
}

.no-reviews { padding: var(--space-5) 0; text-align: center; color: var(--text-tertiary); font-size: var(--text-sm); }
.review-item { padding: var(--space-3) 0; border-bottom: 1rpx solid var(--border-light); }
.review-item:last-child { border-bottom: none; }
.review-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.review-date { font-size: var(--text-xs); color: var(--text-tertiary); }
.review-content { font-size: var(--text-sm); color: var(--text-secondary); line-height: var(--leading-relaxed); }

.bottom-info { flex: 1; display: flex; flex-direction: column; }
.bottom-selected { font-size: var(--text-sm); color: var(--text-secondary); }
.bottom-btn { padding: 0 48rpx; height: 80rpx; font-size: var(--text-md); }

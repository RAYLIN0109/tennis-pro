<view class="vdetail-page page-container">
  <skeleton-loader wx:if="{{loading}}" type="detail" />

  <block wx:elif="{{venue}}">
    <!-- Image Carousel -->
    <swiper
      class="venue-swiper"
      indicator-dots
      indicator-color="rgba(255,255,255,0.5)"
      indicator-active-color="#FFFFFF"
      bindchange="onImageChange"
    >
      <swiper-item wx:for="{{venue.photos.length ? venue.photos : ['/common/images/empty-state.png']}}" wx:key="*this">
        <image class="swiper-img" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>

    <!-- Info Header -->
    <view class="info-card card">
      <view class="info-header">
        <text class="venue-name">{{venue.name}}</text>
        <rating-stars value="{{venue.rating || 0}}" size="sm" readonly="{{true}}" />
      </view>
      <view class="quick-info">
        <text class="quick-item">{{venue.court_count || (venue.courts.length || 0)}}片场地</text>
        <text class="quick-dot">·</text>
        <text class="quick-item">{{venue.business_hours ? venue.business_hours.open + '-' + venue.business_hours.close : '营业中'}}</text>
        <text wx:if="{{venue.price_rules[0]}}" class="quick-dot">·</text>
        <text wx:if="{{venue.display_price}}" class="quick-item accent-text">¥{{venue.display_price}}起/时</text>
      </view>
    </view>

    <!-- Address -->
    <view class="address-card card" bindtap="onNavigate">
      <view class="address-row">
        <view class="address-info">
          <text class="address-text">{{venue.address}}</text>
          <text class="district-text">{{venue.district}}</text>
        </view>
        <view class="navigate-btn btn btn-sm btn-ghost">导航</view>
      </view>
    </view>

    <!-- Court Selector -->
    <view wx:if="{{venue.courts.length > 1}}" class="court-section card">
      <text class="section-title">选择球场</text>
      <scroll-view class="court-scroll" scroll-x enable-flex>
        <view
          wx:for="{{venue.courts}}"
          wx:key="index"
          class="court-tab {{selectedCourtIndex === index ? 'court-tab-active' : ''}}"
          data-index="{{index}}"
          bindtap="onCourtChange"
        >
          <text class="court-name">{{item.name || ('球场' + (index + 1))}}</text>
          <text wx:if="{{item.type}}" class="court-type">{{item.type}}</text>
        </view>
      </scroll-view>
    </view>

    <!-- Schedule -->
    <view class="schedule-section card">
      <text class="section-title">预约时段</text>
      <scroll-view class="date-scroll" scroll-x enable-flex>
        <view
          wx:for="{{dates}}"
          wx:key="date"
          class="date-tab {{selectedDateIndex === index ? 'date-tab-active' : ''}}"
          data-index="{{index}}"
          bindtap="onDateChange"
        >
          <text class="date-label">{{item.label}}</text>
        </view>
      </scroll-view>
      <time-slot-picker
        slots="{{slots}}"
        multi="{{true}}"
        showPrice="{{true}}"
        bind:change="onSlotChange"
      />
    </view>

    <!-- Amenities -->
    <view wx:if="{{venue.facilities && venue.facilities.length > 0}}" class="amenities-section card">
      <text class="section-title">配套设施</text>
      <view class="amenities-grid">
        <text wx:for="{{venue.facilities}}" wx:key="*this" class="amenity-item">{{item}}</text>
      </view>
    </view>

    <!-- Reviews Preview -->
    <view class="reviews-section card">
      <view class="section-header">
        <text class="section-title" style="margin-bottom:0;">用户评价</text>
        <text wx:if="{{reviewCount > 0}}" class="section-more" bindtap="goReviewList">查看全部({{reviewCount}}) ></text>
      </view>
      <view wx:if="{{recentReviews.length === 0}}" class="no-reviews">
        <text>暂无评价</text>
      </view>
      <view wx:for="{{recentReviews}}" wx:key="_id" class="review-item">
        <view class="review-header">
          <rating-stars value="{{item.rating}}" size="sm" readonly="{{true}}" />
          <text class="review-date">{{item.created_at}}</text>
        </view>
        <text class="review-content">{{item.content}}</text>
      </view>
    </view>

    <!-- Bottom Bar -->
    <view class="bottom-bar safe-area-bottom">
      <view class="bottom-info">
        <text wx:if="{{selectedSlots.length}}" class="bottom-selected">已选{{selectedSlots.length}}个时段</text>
        <price-display wx:if="{{selectedSlotTotal > 0}}" amount="{{selectedSlotTotal}}" size="md" />
      </view>
      <view
        class="btn btn-primary bottom-btn {{selectedSlotIndexes.length === 0 ? 'disabled' : ''}}"
        bindtap="goBook"
      >
        立即预约{{selectedSlotIndexes.length > 0 ? ' (' + selectedSlotIndexes.length + '个时段)' : ''}}
      </view>
    </view>
    <view style="height: 180rpx;"></view>
  </block>
</view>

<view class="book-page page-container">
  <!-- Coach Summary -->
  <view class="book-card card">
    <view class="summary-row">
      <image
        class="summary-avatar"
        src="{{coach.user_info.avatar_url || '/common/images/default-avatar.png'}}"
        mode="aspectFill"
      />
      <view class="summary-info">
        <text class="summary-name">{{coach.real_name || '教练'}}</text>
        <view class="summary-tags">
          <text wx:for="{{coach.specialties}}" wx:key="*this" wx:if="{{index < 2}}" class="summary-tag">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Booking Details -->
  <view class="book-card card">
    <text class="card-title">预约详情</text>
    <view class="detail-row">
      <text class="detail-label">日期</text>
      <text class="detail-value">{{date}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">时段</text>
      <view class="detail-slots">
        <text wx:for="{{slots}}" wx:key="index" class="slot-text">{{item.start_time}}-{{item.end_time}}</text>
      </view>
    </view>
    <view class="detail-row">
      <text class="detail-label">时长</text>
      <text class="detail-value">{{durationMinutes}}分钟</text>
    </view>
  </view>

  <!-- Price Breakdown -->
  <view class="book-card card">
    <text class="card-title">费用明细</text>
    <view class="price-breakdown">
      <view wx:for="{{slots}}" wx:key="index" class="price-item">
        <text class="price-item-label">{{item.start_time}}-{{item.end_time}}</text>
        <price-display amount="{{item.price}}" size="sm" />
      </view>
      <view class="price-total">
        <text class="price-total-label">合计</text>
        <price-display amount="{{totalAmount}}" size="lg" />
      </view>
    </view>
  </view>

  <!-- Contact & Notes -->
  <view class="book-card card">
    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input
        class="form-input"
        type="number"
        value="{{contactPhone}}"
        placeholder="选填，方便教练联系您"
        maxlength="11"
        bindinput="onInputPhone"
      />
    </view>
    <view class="form-item form-item-last">
      <text class="form-label">备注</text>
      <input
        class="form-input"
        value="{{notes}}"
        placeholder="选填，如特殊需求"
        bindinput="onInputNotes"
      />
    </view>
  </view>

  <!-- Submit -->
  <view class="submit-bar bottom-bar safe-area-bottom">
    <view class="submit-price">
      <text class="submit-price-label">合计 </text>
      <price-display amount="{{totalAmount}}" size="lg" />
    </view>
    <button
      class="btn btn-primary submit-btn"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      确认预约
    </button>
  </view>

  <view style="height: 200rpx;"></view>
</view>

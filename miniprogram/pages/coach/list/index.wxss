.coach-list-page {
  padding-bottom: 32rpx;
}

.search-wrap {
  padding: var(--space-3) var(--space-4) 0;
  background-color: var(--bg-primary);
}

.sort-bar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: var(--space-2) var(--space-5);
  background-color: var(--bg-primary);
}

.sort-label {
  font-size: var(--text-sm);
  color: var(--accent);
  margin-right: 8rpx;
}

.sort-arrow {
  font-size: 20rpx;
  color: var(--accent);
}

.sort-panel {
  background-color: var(--bg-primary);
  padding: 0 var(--space-5) var(--space-4);
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sort-option {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  background-color: var(--bg-secondary);
}

.sort-option-active {
  background-color: var(--accent-light);
  color: var(--accent);
}

.coach-list {
  padding: var(--space-3) var(--space-4);
}

.coach-card {
  margin-bottom: var(--space-4);
  padding: var(--space-5);
}

.coach-row {
  display: flex;
  align-items: flex-start;
}

.coach-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}

.coach-info {
  flex: 1;
  margin-left: var(--space-4);
  min-width: 0;
}

.coach-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.coach-name {
  font-size: var(--text-md);
  font-weight: var(--font-semibold);
  color: var(--text-primary);
  margin-right: 8rpx;
}

.verified-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
}

.coach-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.coach-tag {
  font-size: var(--text-xs);
  color: var(--text-secondary);
  background-color: var(--bg-secondary);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
}

.coach-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-text {
  font-size: var(--text-xs);
  color: var(--text-secondary);
}

.meta-dot {
  font-size: var(--text-xs);
  color: var(--text-tertiary);
}

.coach-price {
  flex-shrink: 0;
  margin-left: var(--space-3);
}

.coach-bio {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-top: var(--space-3);
  line-height: var(--leading-normal);
}

.loading-wrap, .load-more {
  padding: var(--space-5) 0;
}

.load-more-text {
  display: block;
  text-align: center;
  font-size: var(--text-sm);
  color: var(--text-tertiary);
}

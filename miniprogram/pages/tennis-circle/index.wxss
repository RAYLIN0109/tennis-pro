.tennis-circle {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
}

/* Topic Bar */
.topic-bar {
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  white-space: nowrap;
  flex-shrink: 0;
}

.topics-wrap {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.topic-tag {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.3s;
}

.topic-tag.active {
  color: #1F2A37;
  background: #B8E600;
  font-weight: 600;
}

/* Posts List */
.posts-scroll {
  flex: 1;
  height: 0;
}

/* Post Card */
.post-card {
  background: #fff;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.post-author-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  object-fit: cover;
  margin-right: 16rpx;
}

.author-avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #B8E600, #9ACD32);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.author-avatar-placeholder text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.author-info {
  flex: 1;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.post-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.topic-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.topic-match { background: #E3F2FD; color: #1565C0; }
.topic-tech { background: #F3E5F5; color: #7B1FA2; }
.topic-gear { background: #FFF3E0; color: #E65100; }
.topic-event { background: #FCE4EC; color: #C62828; }
.topic-other { background: #F5F5F5; color: #666; }

/* Post Content */
.post-content {
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* Post Images */
.post-images {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  position: relative;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

.post-image.single {
  width: 400rpx;
  height: 300rpx;
}

.image-more {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 0;
  bottom: 0;
}

.image-more text {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
}

/* Post Stats */
.post-stats {
  display: flex;
  gap: 32rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-icon {
  font-size: 24rpx;
}

.stat-count {
  font-size: 24rpx;
  color: #999;
}

/* States */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* FAB */
.fab {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #B8E600 0%, #9ACD32 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(184, 230, 0, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
}
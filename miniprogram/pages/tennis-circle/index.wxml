<view class="tennis-circle page-container">
  <!-- Topic Filter Bar -->
  <scroll-view scroll-x class="topic-bar" enhanced show-scrollbar="{{false}}">
    <view class="topics-wrap">
      <view
        wx:for="{{topics}}"
        wx:key="index"
        class="topic-tag {{activeTopic === item ? 'active' : ''}}"
        bindtap="onTopicChange"
        data-topic="{{item}}"
      >{{ item }}</view>
    </view>
  </scroll-view>

  <!-- Posts List -->
  <scroll-view
    scroll-y
    class="posts-scroll"
    refresher-enabled="true"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
  >
    <!-- Post Card -->
    <view
      wx:for="{{posts}}"
      wx:key="_id"
      class="post-card"
      bindtap="goPostDetail"
      data-id="{{item._id}}"
    >
      <!-- Author Row -->
      <view class="post-author-row">
        <image
          wx:if="{{item.author_info && item.author_info.avatar_url}}"
          src="{{item.author_info.avatar_url}}"
          class="author-avatar"
          mode="aspectFill"
        />
        <view wx:else class="author-avatar-placeholder">
          <text>{{ item.author_info ? (item.author_info.nickname ? item.author_info.nickname.charAt(0) : '?') : '?' }}</text>
        </view>
        <view class="author-info">
          <text class="author-name">{{ item.author_info ? item.author_info.nickname : '未知用户' }}</text>
          <text class="post-time">{{ formatTime(item.created_at) }}</text>
        </view>
        <view class="topic-badge {{getTopicBadgeClass(item.topic)}}">{{ item.topic }}</view>
      </view>

      <!-- Content Preview -->
      <view class="post-content">
        <text class="content-text line-clamp-3">{{ item.content }}</text>
      </view>

      <!-- Images Preview -->
      <view wx:if="{{item.images && item.images.length > 0}}" class="post-images">
        <image
          wx:for="{{item.images.slice(0, 3)}}"
          wx:key="index"
          src="{{item}}"
          class="post-image {{item.images.length === 1 ? 'single' : ''}}"
          mode="aspectFill"
        />
        <view wx:if="{{item.images.length > 3}}" class="image-more">
          <text>+{{ item.images.length - 3 }}</text>
        </view>
      </view>

      <!-- Stats Row -->
      <view class="post-stats">
        <view class="stat-item">
          <text class="stat-icon">❤️</text>
          <text class="stat-count">{{ item.like_count || 0 }}</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">💬</text>
          <text class="stat-count">{{ item.comment_count || 0 }}</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">👁️</text>
          <text class="stat-count">{{ item.view_count || 0 }}</text>
        </view>
      </view>
    </view>

    <!-- Loading -->
    <view wx:if="{{loading && posts.length > 0}}" class="loading-more">
      <text>加载中...</text>
    </view>

    <!-- Empty State -->
    <view wx:if="{{!loading && posts.length === 0}}" class="empty-state">
      <view class="empty-icon">🎾</view>
      <text class="empty-text">还没有帖子</text>
      <text class="empty-desc">快来发布第一条网球动态吧！</text>
    </view>

    <!-- No More -->
    <view wx:if="{{!loading && !hasMore && posts.length > 0}}" class="no-more">
      <text>— 已加载全部 —</text>
    </view>
  </scroll-view>

  <!-- Floating Action Button -->
  <view class="fab" bindtap="goCreatePost">
    <text class="fab-icon">✏️</text>
  </view>
</view>
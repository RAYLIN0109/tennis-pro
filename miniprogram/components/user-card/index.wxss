.user-card {
  display: flex;
  align-items: center;
}

.user-avatar {
  border-radius: 50%;
  flex-shrink: 0;
}

.user-card-sm .user-avatar {
  width: 56rpx;
  height: 56rpx;
}

.user-card-md .user-avatar {
  width: 72rpx;
  height: 72rpx;
}

.user-card-lg .user-avatar {
  width: 96rpx;
  height: 96rpx;
}

.user-info {
  margin-left: var(--space-3);
  display: flex;
  flex-direction: column;
}

.user-name-row {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: var(--text-base);
  font-weight: var(--font-medium);
  color: var(--text-primary);
}

.user-level {
  margin-top: 4rpx;
  font-size: var(--text-xs);
  padding: 2rpx 12rpx;
  align-self: flex-start;
}
